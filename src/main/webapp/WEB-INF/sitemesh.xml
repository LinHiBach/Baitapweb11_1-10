<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <property name="config.sitemesh.decorator.file" value="/WEB-INF/decorators.xml" />
    <excludes file="${config.sitemesh.decorator.file}" />
    <page-parsers>
        <parser content-type="text/html" class="org.sitemesh.parser.html.HtmlPageParser" />
    </page-parsers>
    <decorator-mappers>
        <mapper class="org.sitemesh.config.ConfigurableSiteMeshFilter" />
    </decorator-mappers>
</sitemesh>
